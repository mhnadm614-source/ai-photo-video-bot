{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-photo-video-bot",
  "main": "worker.js",
  "compatibility_date": "2026-11-12",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-photo-video-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}
